# Server
PORT=3000
NODE_ENV=production

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/bluff_master

# CORS — comma-separated origins allowed to connect.
# For mobile apps use * (mobile HTTP clients don't send an Origin header).
# For web clients add the specific origin, e.g. https://your-app.web.app
CLIENT_ORIGIN=*
